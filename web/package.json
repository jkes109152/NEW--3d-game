{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/prepare.mjs && vinext dev",
    "build": "node scripts/prepare.mjs && vinext build",
    "test": "node --experimental-strip-types --test scripts/test-controls.mjs && node scripts/test-rules.mjs && node --test scripts/test-adapter.mjs && node --experimental-strip-types --test scripts/test-armory.mjs scripts/test-deployment-aiming.mjs && node --experimental-transform-types --test scripts/test-party-client.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "test:multiplayer": "node scripts/test-multiplayer.mjs",
    "test:pvp:unit": "node --experimental-transform-types --test scripts/test-pvp-room.mjs scripts/test-pvp-hud.mjs scripts/test-pvp-controls.mjs scripts/test-pvp-client.mjs scripts/test-pvp-playback.mjs scripts/test-pvp-mouse.mjs",
    "test:pvp:bridge": "node scripts/test-pvp-bridge.mjs",
    "test:pvp:http": "node --experimental-transform-types scripts/test-pvp-http.mjs",
    "test:pvp": "pnpm test:pvp:unit && pnpm test:pvp:bridge && pnpm test:pvp:http"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "pyodide": "^314.0.6",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
